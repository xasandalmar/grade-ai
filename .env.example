# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server-only — never expose to the browser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Resend (server-only — never expose to the browser)
RESEND_API_KEY=
# "Name <address>" the report emails are sent from. Must be on a domain you've
# verified at resend.com/domains, otherwise Resend only delivers to the address
# that owns the Resend account.
RESEND_FROM_EMAIL=
